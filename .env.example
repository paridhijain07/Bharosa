PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bharosa

# PayPal Sandbox Configuration (https://developer.paypal.com)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_CURRENCY=INR
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
CURRENCY_SYMBOL=₹

# AI / LLM Configuration (Supports Gemini or OpenAI-compatible APIs)
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-2.5-flash

# Twilio WhatsApp Sandbox Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Application & Alert Settings
ALERT_SECONDS=30
PUBLIC_BASE_URL=http://localhost:4000
DEV_MODE=true


# Round 3: Adaptive Alert Timing & Two-Way Collector Limits
MIN_SAMPLES=15
MIN_ALERT_SECONDS=20
MAX_ALERT_SECONDS=120
MAX_REMINDERS=4
MAX_DAILY_OUTBOUND=2
MAX_WEEKLY_OUTBOUND=4
QUIET_HOURS_START=21
QUIET_HOURS_END=8
